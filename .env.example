VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# GitHub Releases also need these as Actions secrets with the same names.
# Without them the packaged app shows "Spell Cloud is not configured in this build."

# Confirmation and password-reset emails must open Spell. Add
# spell://auth/callback to Supabase Auth → URL Configuration → Redirect URLs.

